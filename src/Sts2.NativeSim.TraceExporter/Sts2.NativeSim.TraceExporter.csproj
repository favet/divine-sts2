<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>sts2-native-trace-exporter</AssemblyName>
    <RootNamespace>Sts2.NativeSim.TraceExporter</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="sts2" HintPath="$(GameDataDir)\sts2.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GameDataDir)\0Harmony.dll" Private="false" />
    <Reference Include="GodotSharp" HintPath="$(GameDataDir)\GodotSharp.dll" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <None Include="sts2-native-trace-exporter.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Sts2.NativeSim.Core\ReflectionTools.cs" Link="ReflectionTools.cs" />
  </ItemGroup>
  <Target Name="PackageTraceExporter" AfterTargets="Build">
    <MakeDir Directories="$(OutputPath)package" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(OutputPath)package" />
    <Copy SourceFiles="sts2-native-trace-exporter.json" DestinationFolder="$(OutputPath)package" />
  </Target>
</Project>
